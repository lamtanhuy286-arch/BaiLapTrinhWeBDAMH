@model OutfitShop.Models.Order
@{
    ViewData["Title"] = "Chi tiết đơn hàng";
    Layout = "~/Areas/Admin/Views/Shared/_Layout.cshtml";
}

<div class="card border-0 shadow-sm">
    <div class="card-header bg-info text-white fw-bold">
        <i class="fa-solid fa-file-invoice-dollar me-2"></i> Chi Tiết Đơn Hàng #@Model.Id
    </div>
    <div class="card-body">
        <div class="row mb-4">
            <div class="col-md-6">
                <h6 class="fw-bold text-muted mb-2">THÔNG TIN KHÁCH HÀNG</h6>
                <p class="mb-1"><i class="fa-solid fa-user me-2"></i> <strong>Tên:</strong> @(Model.User?.FullName ?? "Khách vãng lai")</p>
                <p class="mb-1"><i class="fa-solid fa-calendar-days me-2"></i> <strong>Ngày đặt:</strong> @Model.OrderDate.ToString("dd/MM/yyyy HH:mm")</p>
            </div>
            <div class="col-md-6 text-md-end">
                <h6 class="fw-bold text-muted mb-2">TRẠNG THÁI ĐƠN HÀNG</h6>
                <span class="badge bg-warning text-dark fs-6 px-3 py-2">@(Model.Status ?? "Chờ xác nhận")</span>
            </div>
        </div>

        <h6 class="fw-bold mb-3"><i class="fa-solid fa-box-open me-2"></i>DANH SÁCH SẢN PHẨM</h6>
        <table class="table table-bordered table-hover align-middle">
            <thead class="table-light">
                <tr>
                    <th>Sản phẩm</th>
                    <th class="text-center">Số lượng</th>
                    <th class="text-end">Đơn giá</th>
                    <th class="text-end">Thành tiền</th>
                </tr>
            </thead>
            <tbody>
                @if (Model.OrderDetails != null)
                {
                    foreach (var item in Model.OrderDetails)
                    {
                        <tr>
                            <td class="fw-semibold text-primary">@(item.Product?.Name ?? "Sản phẩm mã #" + item.ProductId)</td>
                            <td class="text-center">@item.Quantity</td>
                            <td class="text-end">@item.Price.ToString("N0") đ</td>
                            <td class="text-end fw-bold">@((item.Price * item.Quantity).ToString("N0")) đ</td>
                        </tr>
                    }
                }
            </tbody>
            <tfoot>
                <tr>
                    <td colspan="3" class="text-end fw-bold">Tổng cộng:</td>
                    <td class="text-end fw-bold text-danger fs-5">@Model.TotalAmount.ToString("N0") đ</td>
                </tr>
            </tfoot>
        </table>

        <div class="mt-4 text-end">
            <a href="/Admin/Order" class="btn btn-secondary fw-semibold"><i class="fa-solid fa-arrow-left me-1"></i> Quay lại danh sách</a>
        </div>
    </div>
</div>