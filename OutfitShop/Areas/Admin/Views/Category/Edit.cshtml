@model OutfitShop.Models.Category
@{
    ViewData["Title"] = "Chỉnh Sửa Danh Mục";
    Layout = "~/Areas/Admin/Views/Shared/_Layout.cshtml";
}

<div class="card shadow-sm border-0">
    <div class="card-header bg-warning fw-bold text-dark">
        <i class="fa-solid fa-pen-to-square me-2"></i> Chỉnh Sửa Danh Mục #@Model.Id
    </div>
    <div class="card-body">
        <form asp-action="Edit" method="post">
            <input type="hidden" asp-for="Id" />

            <div class="mb-3">
                <label class="form-label fw-semibold">Tên Danh Mục</label>
                <input asp-for="Name" class="form-control" required />
            </div>

            

            <div class="mb-4 form-check">
                <input asp-for="IsActive" class="form-check-input" />
                <label class="form-check-label">Đang hoạt động</label>
            </div>

            <button type="submit" class="btn btn-warning fw-bold"><i class="fa-solid fa-save me-1"></i> Cập nhật</button>
            <a href="/Admin/Category/Index" class="btn btn-secondary"><i class="fa-solid fa-arrow-left me-1"></i> Quay lại</a>
        </form>
    </div>
</div>