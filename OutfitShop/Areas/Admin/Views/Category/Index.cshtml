@model List<OutfitShop.Areas.Admin.Controllers.CategoryController.CategoryMock>
@{
    ViewData["Title"] = "Quản lý danh mục";
    Layout = "~/Areas/Admin/Views/Shared/_Layout.cshtml";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h2 class="fw-bold m-0 text-dark"><i class="fa-solid fa-list me-2"></i>Quản Lý Danh Mục</h2>
    
    <a href="/Admin/Category/Create" class="btn btn-primary fw-semibold">
        <i class="fa-solid fa-plus me-1"></i> Thêm Danh Mục
    </a>
</div>

<div class="card border-0 shadow-sm">
    <div class="card-body p-0">
        <table class="table table-hover table-striped m-0 align-middle">
            <thead class="table-dark">
                <tr>
                    <th class="ps-4">Mã</th>
                    <th>Tên Danh Mục</th>
                    <th>Mô Tả Chi Tiết</th>
                    <th class="text-center">Trạng Thái</th>
                    <th class="text-center pe-4" style="width: 180px;">Hành Động</th>
                </tr>
            </thead>
            <tbody>
                @if (Model != null && Model.Any())
                {
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td class="ps-4 fw-bold">#@item.Id</td>
                            <td class="fw-semibold text-primary">@item.Name</td>
                            <td class="text-muted">@item.Description</td>
                            <td class="text-center">
                                @if (item.IsActive)
                                {
                                    <span class="badge bg-success-subtle text-success px-3 py-2">Đang Hiển Thị</span>
                                }
                                else
                                {
                                    <span class="badge bg-danger-subtle text-danger px-3 py-2">Đang Ẩn</span>
                                }
                            </td>
                            <td class="text-center pe-4">
                                <a href="/Admin/Category/Edit/@item.Id" class="btn btn-sm btn-outline-warning me-1" title="Sửa">
                                    <i class="fa-solid fa-pen"></i>
                                </a>
                                <a href="/Admin/Category/Delete/@item.Id" class="btn btn-sm btn-outline-danger" title="Xóa" onclick="return confirm('Bạn chắc chắn muốn xóa danh mục này?')">
                                    <i class="fa-solid fa-trash"></i>
                                </a>
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="5" class="text-center py-4 text-muted">Chưa có danh mục nào được tạo.</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>