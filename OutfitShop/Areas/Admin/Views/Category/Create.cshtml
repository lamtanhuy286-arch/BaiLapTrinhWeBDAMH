@model OutfitShop.Models.Category
@{
    ViewData["Title"] = "Thêm danh mục";
    Layout = "~/Areas/Admin/Views/Shared/_Layout.cshtml";
}

<div class="card border-0 shadow-sm">
    <div class="card-header bg-primary text-white fw-bold">
        <i class="fa-solid fa-plus me-2"></i> Thêm Danh Mục Mới
    </div>
    <div class="card-body">
        <form asp-action="Create" method="post">
            <div class="mb-3">
                <label asp-for="Name" class="form-label fw-semibold">Tên danh mục</label>
                <input asp-for="Name" class="form-control" required placeholder="Nhập tên danh mục (vd: Áo Hoodie)" />
            </div>
            <div class="form-check mb-4">
                <input type="checkbox" asp-for="IsActive" class="form-check-input" checked />
                <label class="form-check-label fw-semibold">Đang hoạt động</label>
            </div>
            <button type="submit" class="btn btn-primary fw-semibold"><i class="fa-solid fa-save me-1"></i> Lưu danh mục</button>
            <a href="/Admin/Category" class="btn btn-secondary fw-semibold"><i class="fa-solid fa-arrow-left me-1"></i> Quay lại</a>
        </form>
    </div>
</div>