<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Quản Trị OutfitShop</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.2/css/all.min.css" rel="stylesheet" />
    <style>
        /* --- GIAO DIỆN SÁNG (MẶC ĐỊNH) --- */
        body { background-color: #f4f6f9; font-family: 'Segoe UI', sans-serif; transition: background-color 0.3s, color 0.3s; }
        .sidebar { height: 100vh; background-color: #212529; position: fixed; top: 0; left: 0; width: 260px; padding-top: 20px; z-index: 100; transition: all 0.3s; }
        .sidebar-brand { color: #fff; text-align: center; margin-bottom: 25px; }
        .sidebar a { color: #adb5bd; text-decoration: none; padding: 14px 20px; display: block; font-size: 15px; transition: 0.2s; }
        .sidebar a:hover { background-color: #343a40; color: #fff; }
        .sidebar a.active { background-color: #0d6efd; color: #fff; border-left: 4px solid #fff; }
        .main-content { margin-left: 260px; padding: 25px; }
        .navbar-custom { margin-left: 260px; background-color: #fff; border-bottom: 1px solid #dee2e6; transition: background-color 0.3s, color 0.3s; }
        
        /* --- GIAO DIỆN TỐI (DARK MODE TỐI ƯU TOÀN DIỆN) --- */
        body.dark-mode { background-color: #121212; color: #e9ecef; }
        body.dark-mode .navbar-custom { background-color: #1e1e1e; border-bottom-color: #333; }
        body.dark-mode .sidebar { background-color: #000; }
        body.dark-mode .sidebar a { color: #aaa; }
        body.dark-mode .sidebar a.active { background-color: #0d6efd; color: #fff; }
        
        /* Chuyển màu Card, Table, Form, Dropdown sang Dark Mode */
        body.dark-mode .card { background-color: #1e1e1e; border-color: #333 !important; }
        body.dark-mode .card-header, body.dark-mode .card-footer { background-color: #2a2a2a; border-color: #333; }
        body.dark-mode .table { color: #e9ecef; border-color: #444; }
        body.dark-mode .table-light th, body.dark-mode .table-light td { background-color: #2a2a2a; color: #e9ecef; }
        body.dark-mode .table-hover tbody tr:hover { background-color: #333; color: #fff; }
        body.dark-mode .text-dark { color: #e9ecef !important; }
        body.dark-mode .bg-light, body.dark-mode .bg-white { background-color: #1e1e1e !important; }
        body.dark-mode .dropdown-menu { background-color: #2a2a2a; border-color: #444; }
        body.dark-mode .dropdown-item { color: #e9ecef; }
        body.dark-mode .dropdown-item:hover { background-color: #333; color: #fff; }
        body.dark-mode .form-control { background-color: #2a2a2a; border-color: #444; color: #fff; }
        body.dark-mode .form-control:focus { background-color: #333; color: #fff; border-color: #0d6efd; box-shadow: none; }
        body.dark-mode .text-muted { color: #888 !important; }
    </style>
</head>
<body>

    <div class="sidebar">
        <div class="sidebar-brand">
            <h4 class="fw-bold"><i class="fa-solid fa-shirt me-2"></i>OUTFIT SHOP</h4>
            <small class="text-white-50">Admin Control Panel</small>
        </div>
        
        <a href="/Admin/Home" class="@(ViewContext.RouteData.Values["Controller"]?.ToString() == "Home" ? "active" : "")">
            <i class="fa-solid fa-gauge me-3"></i> Trang tổng quan
        </a>
        <a href="/Admin/Category" class="@(ViewContext.RouteData.Values["Controller"]?.ToString() == "Category" ? "active" : "")">
            <i class="fa-solid fa-list me-3"></i> Quản lý danh mục
        </a>
        <a href="/Admin/Product" class="@(ViewContext.RouteData.Values["Controller"]?.ToString() == "Product" ? "active" : "")">
            <i class="fa-solid fa-shirt me-3"></i> Quản lý sản phẩm
        </a>
        <a href="/Admin/Order" class="@(ViewContext.RouteData.Values["Controller"]?.ToString() == "Order" ? "active" : "")">
            <i class="fa-solid fa-cart-shopping me-3"></i> Quản lý đơn hàng
        </a>
        <a href="/Admin/Customer" class="@(ViewContext.RouteData.Values["Controller"]?.ToString() == "Customer" ? "active" : "")">
            <i class="fa-solid fa-users me-3"></i> Quản lý khách hàng
        </a>
        <a href="/Admin/Review" class="@(ViewContext.RouteData.Values["Controller"]?.ToString() == "Review" ? "active" : "")">
            <i class="fa-solid fa-comments me-3"></i> Quản lý đánh giá
        </a>
        
        <div class="mt-4 px-3">
            <hr class="text-secondary" />
            <a href="/Account/Logout" class="text-danger"><i class="fa-solid fa-right-from-bracket me-3"></i> Đăng xuất</a>
        </div>
    </div>

    <nav class="navbar navbar-expand-lg navbar-light navbar-custom py-2 px-4 shadow-sm">
        <div class="container-fluid justify-content-between">
            <nav aria-label="breadcrumb">
                <ol class="breadcrumb mb-0">
                    <li class="breadcrumb-item"><a href="/Admin/Home" class="text-decoration-none">Trang tổng quan</a></li>
                    <li class="breadcrumb-item active fw-bold" aria-current="page">@ViewData["Title"]</li>
                </ol>
            </nav>

            <div class="d-flex align-items-center">
                <button id="toggleMode" class="btn btn-sm btn-outline-secondary me-3" title="Bật/Tắt giao diện tối">
                    <i class="fa-solid fa-moon"></i>
                </button>
                <div class="dropdown">
                    <a class="nav-link dropdown-toggle fw-bold text-dark" href="#" data-bs-toggle="dropdown">
                        <i class="fa-solid fa-user-gear me-2 text-primary"></i> Xin chào, Admin
                    </a>
                    <ul class="dropdown-menu dropdown-menu-end shadow border-0 mt-2">
                        <li><a class="dropdown-item py-2" href="/"><i class="fa-solid fa-house me-2"></i>Về trang web</a></li>
                        <li><hr class="dropdown-divider"></li>
                        <li><a class="dropdown-item py-2 text-danger fw-bold" href="/Account/Logout"><i class="fa-solid fa-power-off me-2"></i>Đăng xuất</a></li>
                    </ul>
                </div>
            </div>
        </div>
    </nav>

    <div class="main-content">
        @RenderBody()
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
    <script>
        const toggleBtn = document.getElementById('toggleMode');
        
        // 1. Kiểm tra bộ nhớ trình duyệt xem người dùng có đang bật Dark Mode không
        if (localStorage.getItem('theme') === 'dark') {
            document.body.classList.add('dark-mode');
            toggleBtn.innerHTML = '<i class="fa-solid fa-sun text-warning"></i>';
        }

        // 2. Lắng nghe sự kiện click để bật/tắt
        toggleBtn.addEventListener('click', () => {
            document.body.classList.toggle('dark-mode');
            const isDark = document.body.classList.contains('dark-mode');
            
            // Đổi icon và lưu trạng thái vào localStorage
            toggleBtn.innerHTML = isDark ? '<i class="fa-solid fa-sun text-warning"></i>' : '<i class="fa-solid fa-moon"></i>';
            localStorage.setItem('theme', isDark ? 'dark' : 'light');
        });
    </script>
    
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>