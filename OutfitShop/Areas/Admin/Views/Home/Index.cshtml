@{
    ViewData["Title"] = "Trang tổng quan";
    Layout = "~/Areas/Admin/Views/Shared/_Layout.cshtml";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h2 class="fw-bold m-0 text-dark"><i class="fa-solid fa-gauge me-2"></i>Trang Tổng Quan</h2>
</div>

<div class="row g-4 mb-4">
    <div class="col-md-3">
        <div class="card bg-primary text-white border-0 shadow-sm p-4 h-100">
            <div class="d-flex justify-content-between align-items-start">
                <div>
                    <h6 class="text-white-50 mb-1">Doanh Thu Hệ Thống</h6>
                    <h3 class="fw-bold m-0">@ViewBag.TotalRevenue</h3>
                </div>
                <i class="fa-solid fa-sack-dollar fs-2 opacity-50"></i>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card bg-success text-white border-0 shadow-sm p-4 h-100">
            <div class="d-flex justify-content-between align-items-start">
                <div>
                    <h6 class="text-white-50 mb-1">Tổng Đơn Hàng</h6>
                    <h3 class="fw-bold m-0">@ViewBag.TotalOrders</h3>
                </div>
                <i class="fa-solid fa-cart-shopping fs-2 opacity-50"></i>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card bg-warning text-dark border-0 shadow-sm p-4 h-100">
            <div class="d-flex justify-content-between align-items-start">
                <div>
                    <h6 class="text-dark-50 mb-1">Thành Viên Đăng Ký</h6>
                    <h3 class="fw-bold m-0">@ViewBag.TotalCustomers</h3>
                </div>
                <i class="fa-solid fa-users fs-2 opacity-50"></i>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card bg-info text-white border-0 shadow-sm p-4 h-100">
            <div class="d-flex justify-content-between align-items-start">
                <div>
                    <h6 class="text-white-50 mb-1">Đánh Giá & Phản Hồi</h6>
                    <h3 class="fw-bold m-0">@ViewBag.TotalReviews</h3>
                </div>
                <i class="fa-solid fa-comments fs-2 opacity-50"></i>
            </div>
        </div>
    </div>
</div>

<div class="row">
    <div class="col-md-12">
        <div class="card border-0 shadow-sm p-4">
            <h5 class="fw-bold mb-4 text-dark"><i class="fa-solid fa-chart-line text-primary me-2"></i>Biểu Đồ Xu Hướng Doanh Thu Dự Kiến (2026)</h5>
            <div style="height: 350px; width: 100%;">
                <canvas id="revenueChart"></canvas>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <script>
        const ctx = document.getElementById('revenueChart').getContext('2d');
        new Chart(ctx, {
        type: 'bar',
        data: {
        labels: ['Tháng 1', 'Tháng 2', 'Tháng 3', 'Tháng 4', 'Tháng 5', 'Tháng 6'],
        datasets: [{
        label: 'Doanh Thu Thực Tế (Triệu VND)',
        data: [45, 68, 52, 95, 110, 124.5],
        backgroundColor: '#0d6efd',
        borderRadius: 8,
        barThickness: 50
        }]
        },
        options: {
        responsive: true,
        maintainAspectRatio: false,
        scales: { y: { beginAtZero: true } }
        }
        });
    </script>
}