@model OutfitShop.Models.Product
@{
    ViewData["Title"] = Model?.Name ?? "Chi tiết sản phẩm";
}

@if (Model == null)
{
    <div class="container py-5 text-center" style="min-height: 50vh;">
        <i class="fa-solid fa-box-open text-muted fa-4x mb-3"></i>
        <h3 class="text-muted fw-bold">Sản phẩm không tồn tại hoặc đã bị xóa!</h3>
        <a href="/Product/Index" class="btn btn-dark mt-4 fw-bold px-4 py-2">QUAY LẠI CỬA HÀNG</a>
    </div>
}
else
{
    <div class="container py-5">
        <nav aria-label="breadcrumb" class="mb-4">
            <ol class="breadcrumb">
                <li class="breadcrumb-item"><a href="/Home/Index" class="text-decoration-none text-dark">Trang chủ</a></li>
                <li class="breadcrumb-item"><a href="/Product/Index" class="text-decoration-none text-dark">Sản phẩm</a></li>
                <li class="breadcrumb-item active" aria-current="page">@Model.Name</li>
            </ol>
        </nav>

        <div class="row g-5">
            <div class="col-md-6">
                <div class="card border-0 shadow-sm rounded-4 overflow-hidden position-relative bg-light">
                    <img src="@(!string.IsNullOrEmpty(Model.ImageUrl) ? Model.ImageUrl : "https://via.placeholder.com/600x600")"
                         class="img-fluid w-100" alt="@Model.Name" style="object-fit: cover; max-height: 600px;"
                         onerror="this.src='https://via.placeholder.com/600x600';">
                </div>
            </div>

            <div class="col-md-6">
                <h1 class="fw-bold text-uppercase mb-3">@Model.Name</h1>
                
                <div class="d-flex align-items-center mb-3">
                    <div class="text-warning me-2">
                        <i class="fa-solid fa-star"></i>
                        <i class="fa-solid fa-star"></i>
                        <i class="fa-solid fa-star"></i>
                        <i class="fa-solid fa-star"></i>
                        <i class="fa-solid fa-star-half-stroke"></i>
                    </div>
                    <span class="text-muted small">(Đánh giá tích cực)</span>
                </div>
                
                <h2 class="text-danger fw-bold mb-4">@Model.Price.ToString("N0") đ</h2>
                
                <p class="text-muted mb-4" style="line-height: 1.8;">
                    @Model.Description
                </p>

                <hr class="mb-4">

                <div class="row align-items-end mb-4 g-3">
                    <div class="col-auto">
                        <label class="form-label fw-bold small">Số lượng</label>
                        <input type="number" id="qty-@Model.Id" class="form-control text-center form-control-lg bg-light" value="1" min="1" style="width: 120px;">
                    </div>
                    <div class="col">
                        <button class="btn btn-dark btn-lg w-100 fw-bold shadow" onclick="addToCart(@Model.Id)">
                            <i class="fa-solid fa-cart-plus me-2"></i>THÊM VÀO GIỎ HÀNG
                        </button>
                    </div>
                </div>
                
                <div class="d-flex gap-4 mt-4 small fw-semibold text-muted border p-3 rounded-3 bg-light">
                    <span><i class="fa-solid fa-truck-fast me-2 text-dark fs-5 align-middle"></i> Giao hàng toàn quốc</span>
                    <span><i class="fa-solid fa-rotate-left me-2 text-dark fs-5 align-middle"></i> Đổi trả trong 7 ngày</span>
                </div>
            </div>
        </div>

        <div class="mt-5 pt-5 border-top">
            <h3 class="fw-bold mb-4 text-uppercase"><i class="fa-solid fa-comments me-2"></i>Đánh Giá Sản Phẩm</h3>

            <div class="row g-4">
                <div class="col-lg-5 mb-4">
                    <div class="card p-4 shadow-sm border-0 bg-light rounded-3 h-100">
                        <h5 class="fw-bold mb-3">Viết đánh giá của bạn</h5>
                        
                        <div id="star-rating" class="mb-3 fs-4">
                            <i class="fa-solid fa-star text-warning" style="cursor:pointer;" onclick="setRating(1)"></i>
                            <i class="fa-solid fa-star text-warning" style="cursor:pointer;" onclick="setRating(2)"></i>
                            <i class="fa-solid fa-star text-warning" style="cursor:pointer;" onclick="setRating(3)"></i>
                            <i class="fa-solid fa-star text-warning" style="cursor:pointer;" onclick="setRating(4)"></i>
                            <i class="fa-solid fa-star text-warning" style="cursor:pointer;" onclick="setRating(5)"></i>
                        </div>
                        
                        <textarea id="commentContent" class="form-control mb-3 border-0 shadow-sm" rows="4" placeholder="Sản phẩm này chất lượng thế nào? Chia sẻ cảm nhận của bạn nhé..."></textarea>
                        
                        <button onclick="submitProductReview(@Model.Id)" class="btn btn-primary fw-bold w-100 py-2">GỬI ĐÁNH GIÁ</button>
                    </div>
                </div>

                <div class="col-lg-7">
                    <div id="review-list" class="d-flex flex-column gap-3">
                        <div class="p-3 border rounded-3 bg-white shadow-sm">
                            <div class="d-flex justify-content-between align-items-center mb-2">
                                <span class="fw-bold"><i class="fa-solid fa-circle-user text-muted me-2 fs-5 align-middle"></i>Thành viên ẩn danh</span>
                                <div class="text-warning small">
                                    <i class="fa-solid fa-star"></i><i class="fa-solid fa-star"></i><i class="fa-solid fa-star"></i><i class="fa-solid fa-star"></i><i class="fa-solid fa-star"></i>
                                </div>
                            </div>
                            <p class="m-0 text-muted">Chất vải rất đẹp, đúng form streetwear. Lên đồ bao ngầu, sẽ tiếp tục ủng hộ shop!</p>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
}

@section Scripts {
    <script>
        let currentRating = 5;

        // Xử lý đồ họa cho Ngôi Sao
        function setRating(val) {
            currentRating = val;
            $('#star-rating i').removeClass('fa-solid text-warning').addClass('fa-regular text-secondary');
            $('#star-rating i').each(function(index) {
                if(index < val) {
                    $(this).removeClass('fa-regular text-secondary').addClass('fa-solid text-warning');
                }
            });
        }

        // Xử lý gửi Đánh Giá (AJAX)
        function submitProductReview(productId) {
            // Kiểm tra trạng thái đăng nhập trước khi cho viết đánh giá
            let isLoggedIn = @((User.Identity?.IsAuthenticated == true).ToString().ToLower());
            if (!isLoggedIn) {
                if (confirm("Vui lòng đăng nhập để đánh giá sản phẩm. Bạn có muốn chuyển đến trang Đăng nhập không?")) {
                    window.location.href = '/Account/Login';
                }
                return;
            }

            let content = $('#commentContent').val().trim();
            if(!content) {
                alert("Bạn chưa nhập nội dung đánh giá!");
                return;
            }

            $.ajax({
                url: '/Product/AddReview',
                type: 'POST',
                data: { productId: productId, comment: content, rating: currentRating },
                success: function(res) {
                    if(res.success) {
                        alert(res.message);
                        
                        let starsHtml = '';
                        for(let i=1; i<=5; i++) {
                            starsHtml += (i <= currentRating) ? '<i class="fa-solid fa-star"></i>' : '<i class="fa-regular fa-star"></i>';
                        }

                        let newReview = `
                            <div class="p-3 border border-primary rounded-3 bg-white shadow-sm" style="display:none;" id="new-review">
                                <div class="d-flex justify-content-between align-items-center mb-2">
                                    <span class="fw-bold text-primary"><i class="fa-solid fa-circle-user me-2 fs-5 align-middle"></i>Bạn (Vừa xong)</span>
                                    <div class="text-warning small">${starsHtml}</div>
                                </div>
                                <p class="m-0 text-dark">${content}</p>
                            </div>`;
                            
                        $('#review-list').prepend(newReview);
                        $('#new-review').fadeIn();
                        $('#commentContent').val('');
                    } else {
                        alert(res.message);
                    }
                },
                error: function() {
                    alert("Có lỗi kết nối mạng, vui lòng thử lại!");
                }
            });
        }

        // Xử lý chức năng Thêm Vào Giỏ (Đã fix lỗi và thêm bảo mật)
        function addToCart(productId) {
            // Ông bảo vệ: Kiểm tra xem khách đã xuất trình thẻ thành viên chưa
            let isLoggedIn = @((User.Identity?.IsAuthenticated == true).ToString().ToLower());
            if (!isLoggedIn) {
                if (confirm("Vui lòng đăng nhập để mua hàng! Bạn có muốn chuyển đến trang Đăng nhập không?")) {
                    window.location.href = '/Account/Login';
                }
                return; // Chặn lại, không chạy dòng code nào bên dưới nữa
            }

            // Nếu đã đăng nhập thì lấy số lượng khách nhập và gửi lên Server
            let qty = $('#qty-' + productId).val();
            
            $.ajax({
                url: '/Cart/AddToCart',
                type: 'POST',
                // Chú ý tên biến 'id' để khớp với tham số int id trong C#
                data: { id: productId, quantity: qty },
                success: function(res) {
                    if(res.success) {
                        if (confirm("Đã thêm sản phẩm vào giỏ hàng thành công! Bạn có muốn đi đến Giỏ hàng ngay không?")) {
                            window.location.href = '/Cart/Index';
                        }
                    } else {
                        alert("Có lỗi xảy ra: " + res.message);
                    }
                },
                error: function() {
                    alert("Không thể kết nối đến máy chủ. Vui lòng kiểm tra lại mạng!");
                }
            });
        }
    </script>
}