@using Microsoft.AspNetCore.Http
@using OutfitShop.Helpers
@using OutfitShop.Models
@{
    // Tự động đọc Session Giỏ hàng để đếm xem có bao nhiêu món đồ
    var cart = Context.Session.GetObject<List<CartItem>>("Cart");
    int cartCount = cart != null ? cart.Sum(item => item.Quantity) : 0;

    // GIẢI PHÁP AN TOÀN TUYỆT ĐỐI: Đọc trực tiếp Cookie ngôn ngữ mặc định của ASP.NET Core
    // Chuỗi cookie mặc định hệ thống lưu là: .AspNetCore.Culture
    var cookieCulture = Context.Request.Cookies[".AspNetCore.Culture"];

    // Mặc định ban đầu nếu chưa chọn gì sẽ là Tiếng Việt ("vi")
    var currentCultureName = "vi";

    // Nếu có cookie (ví dụ chuỗi: c=en|uic=en), ta bốc tách lấy mã ngôn ngữ ra
    if (!string.IsNullOrEmpty(cookieCulture) && cookieCulture.Contains("c="))
    {
        // Cắt chuỗi lấy phần sau "c=" (ví dụ: en hoặc vi)
        var startIndex = cookieCulture.IndexOf("c=") + 2;
        var endIndex = cookieCulture.IndexOf("|", startIndex);
        currentCultureName = endIndex > 0
            ? cookieCulture.Substring(startIndex, endIndex - startIndex)
            : cookieCulture.Substring(startIndex);
    }
}
<!DOCTYPE html>
<html lang="@currentCultureName">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - OutfitShop</title>

    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/OutfitShop.styles.css" asp-append-version="true" />

    <style>
            body {
                font-family: 'Inter', sans-serif;
                background-color: #fff; /* Nền trắng tinh khôi */
                color: #111;
            }

            /* Tùy chỉnh thanh tìm kiếm dạng gạch chân */
            .search-minimal {
                border: none;
                border-bottom: 1px solid #ddd;
                border-radius: 0;
                padding-left: 0;
                font-size: 13px;
                box-shadow: none !important;
                transition: border-color 0.3s;
            }

                .search-minimal:focus {
                    border-bottom: 1px solid #000;
                }

            /* Tùy chỉnh Icon Navbar */
            .nav-icon {
                color: #111;
                font-size: 1.15rem;
                transition: opacity 0.2s;
            }

                .nav-icon:hover {
                    opacity: 0.6;
                }

            /* Định dạng Menu Dropdown tối giản */
            .dropdown-menu-minimal {
                border-radius: 0;
                border: 1px solid #eaeaea;
                box-shadow: 0 10px 30px rgba(0,0,0,0.05);
                font-size: 14px;
            }

                .dropdown-menu-minimal .dropdown-item {
                    padding: 10px 20px;
                    transition: background 0.2s;
                }

                    .dropdown-menu-minimal .dropdown-item:hover {
                        background-color: #f8f9fa;
                    }

            /* Tùy chỉnh nút chuyển đổi ngôn ngữ tối giản */
            .lang-link {
                font-size: 12px;
                text-decoration: none;
                color: #999;
                transition: color 0.2s;
                font-weight: 500;
            }

                .lang-link:hover, .lang-link.active {
                    color: #111;
                }
    </style>
</head>
<body class="bg-white">
    <header>
        <div class="border-bottom py-1 bg-light">
            <div class="container d-flex justify-content-end align-items-center gap-2">
                <a href="@Url.Action("Change", "Language", new { culture = "vi", returnUrl = Context.Request.Path + Context.Request.QueryString })"
                   class="lang-link @(currentCultureName.StartsWith("vi") ? "active" : "")">
                    VN
                </a>
                <span class="text-muted" style="font-size: 12px;">|</span>
                <a href="@Url.Action("Change", "Language", new { culture = "en", returnUrl = Context.Request.Path + Context.Request.QueryString })"
                   class="lang-link @(currentCultureName.StartsWith("en") ? "active" : "")">
                    EN
                </a>
            </div>
        </div>

        <nav class="navbar navbar-expand-lg navbar-light bg-white border-bottom py-3">
            <div class="container d-flex justify-content-between align-items-center">

                <a class="navbar-brand fw-bold fs-4 text-dark m-0" style="letter-spacing: -1.5px;" asp-area="" asp-controller="Home" asp-action="Index">
                    OUTFIT<span class="text-muted">SHOP</span>
                </a>

                <button class="navbar-toggler border-0 shadow-none" type="button" data-bs-toggle="collapse" data-bs-target="#mainMenu">
                    <span class="navbar-toggler-icon"></span>
                </button>

                <div class="collapse navbar-collapse justify-content-center" id="mainMenu">
                    <ul class="navbar-nav gap-2 gap-lg-4 mt-3 mt-lg-0">
                        <li class="nav-item">
                            <a class="nav-link text-dark fw-semibold" asp-area="" asp-controller="Home" asp-action="Index" style="font-size: 14px;">@SharedLocalizer["Home"]</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-dark fw-semibold" asp-area="" asp-controller="Product" asp-action="Index" style="font-size: 14px;">@SharedLocalizer["Products"]</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-dark fw-semibold" href="/PhieuPhoiDo" style="font-size: 14px;">@SharedLocalizer["FittingRoom"]</a>
                        </li>
                    </ul>
                </div>

                <div class="d-flex align-items-center gap-4 d-none d-lg-flex">

                    <form class="d-flex mb-0 align-items-center" asp-controller="Product" asp-action="Search" method="get">
                        <input class="form-control form-control-sm search-minimal" type="search" placeholder="@SharedLocalizer["SearchPlaceholder"]" name="query" required style="width: 140px;">
                        <button class="btn btn-link text-dark px-2 shadow-none text-decoration-none" type="submit">
                            <i class="fa-solid fa-magnifying-glass fs-6"></i>
                        </button>
                    </form>

                    <a href="/Cart/Index" class="nav-icon position-relative text-decoration-none" title="@SharedLocalizer["Cart"]">
                        <i class="fa-solid fa-bag-shopping"></i>
                        @if (cartCount > 0)
                        {
                            <span class="position-absolute top-0 start-100 translate-middle badge rounded-pill bg-dark" style="font-size: 0.6rem; padding: 0.25em 0.4em;">
                                @cartCount
                            </span>
                        }
                    </a>

                    <div class="dropdown">
                        <a href="#" class="nav-icon text-decoration-none" data-bs-toggle="dropdown">
                            <i class="fa-regular fa-user"></i>
                        </a>
                        <ul class="dropdown-menu dropdown-menu-end dropdown-menu-minimal mt-3">
                            @if (User?.Identity?.IsAuthenticated == true)
                            {
                                <li><span class="dropdown-item-text text-muted small fw-semibold">@SharedLocalizer["WelcomeUser"], @User.Identity.Name</span></li>
                                <li><hr class="dropdown-divider"></li>

                                @if (User.IsInRole("Admin"))
                                {
                                    <li><a class="dropdown-item" href="/Admin/Home/Index">@SharedLocalizer["AdminPanel"]</a></li>
                                }
                                <li><a class="dropdown-item" href="/Order/History">@SharedLocalizer["OrderHistory"]</a></li>
                                <li><hr class="dropdown-divider"></li>
                                <li><a class="dropdown-item text-danger fw-semibold" href="/Account/Logout">@SharedLocalizer["Logout"]</a></li>
                            }
                            else
                            {
                                <li><a class="dropdown-item" href="/Account/Login">@SharedLocalizer["Login"]</a></li>
                                <li><a class="dropdown-item" href="/Account/Register">@SharedLocalizer["Register"]</a></li>
                            }
                        </ul>
                    </div>
                </div>
            </div>
        </nav>
    </header>

    <div class="container">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <footer class="border-top footer text-muted mt-5 py-5 bg-white">
        <div class="container d-flex flex-column flex-md-row justify-content-between align-items-center" style="font-size: 13px;">
            <div class="fw-bold text-dark fs-5 mb-3 mb-md-0" style="letter-spacing: -1px;">
                OUTFIT<span class="text-muted">SHOP</span>
            </div>

            <div class="text-center mb-3 mb-md-0 text-muted">
                &copy; 2026 OUTFITSHOP. Curation & Precision.
            </div>

            <div class="d-flex gap-4 fw-medium">
                <a href="#" class="text-muted text-decoration-none hover-dark">@SharedLocalizer["Contact"]</a>
                <a href="#" class="text-muted text-decoration-none hover-dark">@SharedLocalizer["SocialMedia"]</a>
                <a asp-area="" asp-controller="Home" asp-action="Privacy" class="text-muted text-decoration-none hover-dark">@SharedLocalizer["PrivacyPolicy"]</a>
            </div>
        </div>
    </footer>

    <script src="https://code.jquery.com/jquery-3.7.0.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>