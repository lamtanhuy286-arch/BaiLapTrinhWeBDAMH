@model OutfitShop.DTOs.LoginDTO
@{
    ViewData["Title"] = "Đăng Nhập Thành Viên";
}

<div class="row justify-content-center align-items-center" style="min-height: 60vh;">
    <div class="col-md-5">
        <div class="card border-0 shadow rounded-3 p-4 bg-white">
            <div class="text-center mb-4">
                <h4 class="fw-bold m-0 text-uppercase">Đăng Nhập Hệ Thống</h4>
                <small class="text-muted">Chào mừng bạn trở lại với OutfitShop</small>
            </div>
            
            <div asp-validation-summary="All" class="text-danger small mb-3 text-center fw-semibold"></div>

            <form asp-controller="Account" asp-action="Login" method="post">
                <div class="mb-3">
                    <label class="form-label small fw-bold">Địa chỉ Email</label>
                    <div class="input-group">
                        <span class="input-group-text bg-light border-end-0"><i class="fa-solid fa-envelope text-muted"></i></span>
                        <input asp-for="Email" class="form-control bg-light border-start-0" required placeholder="example@gmail.com">
                    </div>
                </div>

                <div class="mb-3">
                    <label class="form-label small fw-bold">Mật khẩu</label>
                    <div class="input-group">
                        <span class="input-group-text bg-light border-end-0"><i class="fa-solid fa-lock text-muted"></i></span>
                        <input asp-for="Password" type="password" class="form-control bg-light border-start-0" required placeholder="******">
                    </div>
                </div>

                <div class="d-flex justify-content-between align-items-center mb-4">
                    <div class="form-check">
                        <input asp-for="RememberMe" class="form-check-input">
                        <label class="form-check-label small" asp-for="RememberMe">Ghi nhớ đăng nhập</label>
                    </div>
                    <a href="#" class="small text-decoration-none text-muted">Quên mật khẩu?</a>
                </div>

                <button type="submit" class="btn btn-dark w-100 py-2 fw-bold mb-3">ĐĂNG NHẬP</button>
                <p class="text-center small m-0 text-muted">Chưa có tài khoản? <a href="/Account/Register" class="text-primary text-decoration-none fw-bold">Đăng ký ngay</a></p>
            </form>
        </div>
    </div>
</div>