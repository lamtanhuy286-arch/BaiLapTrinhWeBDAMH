@model OutfitShop.Models.Order
@{
    ViewData["Title"] = "Chi tiết đơn hàng #" + Model.Id;
}

<div class="container py-5" style="min-height: 60vh;">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2 class="fw-bold text-uppercase m-0">
            <i class="fa-solid fa-file-invoice-dollar me-2"></i>Chi tiết Đơn hàng #@Model.Id
        </h2>
        <a href="/Order/History" class="btn btn-outline-dark fw-bold"><i class="fa-solid fa-arrow-left me-2"></i>Quay lại</a>
    </div>

    <div class="row g-4">
        <div class="col-md-4">
            <div class="card shadow-sm border-0 p-4 h-100 bg-white">
                <h5 class="fw-bold mb-3 border-bottom pb-2">Thông tin Đơn hàng</h5>
                <p class="mb-2"><span class="text-muted small">Ngày đặt:</span> <br> <span class="fw-semibold">@Model.OrderDate.ToString("dd/MM/yyyy HH:mm")</span></p>
                <p class="mb-2"><span class="text-muted small">Trạng thái:</span> <br> <span class="badge bg-warning text-dark fw-bold px-3 py-2 mt-1">@Model.Status</span></p>
                <p class="mb-0 mt-3"><span class="text-muted small">Mã khách hàng:</span> <br> <span class="fw-semibold text-truncate d-block">@Model.UserId</span></p>
            </div>
        </div>

        <div class="col-md-8">
            <div class="card shadow-sm border-0 bg-white overflow-hidden">
                <div class="table-responsive">
                    <table class="table table-hover align-middle m-0">
                        <thead class="table-light">
                            <tr>
                                <th class="ps-4">Sản phẩm</th>
                                <th class="text-center">Đơn giá</th>
                                <th class="text-center">SL</th>
                                <th class="text-end pe-4">Thành tiền</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (Model.OrderDetails != null)
                            {
                                foreach (var item in Model.OrderDetails)
                                {
                                    <tr>
                                        <td class="ps-4">
                                            <div class="d-flex align-items-center">
                                                <i class="fa-solid fa-shirt text-muted me-3 fs-4"></i>
                                                <div>
                                                    <span class="fw-semibold d-block">@(item.Product?.Name ?? "Sản phẩm mã #" + item.ProductId)</span>
                                                </div>
                                            </div>
                                        </td>
                                        <td class="text-center">@item.Price.ToString("N0") đ</td>
                                        <td class="text-center fw-bold">x @item.Quantity</td>
                                        <td class="text-end pe-4 fw-bold text-dark">@((item.Price * item.Quantity).ToString("N0")) đ</td>
                                    </tr>
                                }
                            }
                        </tbody>
                        <tfoot class="table-light">
                            <tr>
                                <td colspan="3" class="text-end fw-bold">Tổng cộng:</td>
                                <td class="text-end pe-4 fw-bold text-danger fs-5">@Model.TotalAmount.ToString("N0") đ</td>
                            </tr>
                        </tfoot>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>